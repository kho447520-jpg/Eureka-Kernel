- name: Setup KernelSUNext
  working-directory: ./kernel
  run: |
    echo "=== Đang ở thư mục gốc của kernel: $(pwd) ==="
    
    # 1. Chạy script setup tải KernelSU-Next
    curl -LSs "https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/next/kernel/setup.sh" | bash -s legacy v3.3.0
    
    # 2. Tìm thư mục KernelSU (hoặc KernelSU-Next) ở bất kỳ đâu vừa được tải về
    KSU_DIR=$(find . -maxdepth 3 -type d -name "KernelSU*" | head -n 1)
    
    if [ -z "$KSU_DIR" ]; then
      echo "LỖI NGHIÊM TRỌNG: Script setup không tải được thư mục KernelSU nào!"
      exit 1
    fi
    
    echo "Tìm thấy thư mục KSU tại: $KSU_DIR"
    
    # 3. Nếu nó không nằm ngay thư mục gốc (tên là ./KernelSU), tiến hành di chuyển/đổi tên
    if [ "$KSU_DIR" != "./KernelSU" ]; then
      echo "Thư mục đang nằm sai chỗ hoặc sai tên. Tiến hành di chuyển về thư mục gốc..."
      # Xóa thư mục KernelSU cũ nếu nó bị rỗng hoặc lỗi (tùy chọn, cẩn thận)
      rm -rf ./KernelSU 
      # Di chuyển và đổi tên thành KernelSU
      mv "$KSU_DIR" ./KernelSU
      echo "Đã di chuyển thành công về ./KernelSU"
    fi
    
    # 4. Kiểm tra lại lần cuối
    echo "=== Kiểm tra lại thư mục KernelSU tại gốc ==="
    if [ -d "KernelSU" ]; then
      echo "✅ THÀNH CÔNG: Thư mục KernelSU đã sẵn sàng!"
      ls -la KernelSU/ | head -n 10
    else
      echo "❌ THẤT BẠI: Không thể đưa KernelSU về thư mục gốc!"
      exit 1
    fi