name: Build R15-OneUI + BPF merge from R24U

on:
  workflow_dispatch:
  push:
    branches: [ testing ]

env:
  KERNEL_BRANCH: R24U # Đã sửa theo tên nhánh thực tế của bạn

jobs:
  build:
    runs-on: ubuntu-24.04
    strategy:
      fail-fast: false
      matrix:
        defconfig:
          - exynos7885-a10_defconfig
          - exynos7885-a20_defconfig
          - exynos7885-a30_defconfig
          - exynos7885-a30s_defconfig
          - exynos7885-a40_defconfig

    steps:
      - name: Checkout kernel source
        uses: actions/checkout@v4
        with:
          ref: ${{ env.KERNEL_BRANCH }}
          path: kernel
          fetch-depth: 0

      - name: Set Git user
        working-directory: ./kernel
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"

      # 1. Cài đặt KernelSU-Next TRỰC TIẾP bằng Git Clone (Không dùng script setup.sh để tránh lỗi thư mục)
      - name: Setup KernelSUNext (Clone & Verify)
        working-directory: ./kernel
        run: |
          echo "=== Đang ở thư mục gốc của kernel: $(pwd) ==="
          
          # Xóa thư mục cũ nếu có để tránh xung đột
          rm -rf KernelSU
          
          # Clone trực tiếp KernelSU-Next v3.3.0
          git clone --depth=1 -b next https://github.com/KernelSU-Next/KernelSU-Next.git KernelSU
          cd KernelSU
          git fetch --depth=1 origin tag v3.3.0
          git checkout v3.3.0
          cd ..
          
          # Kiểm tra xem Makefile đã có chưa
          if [ -f "KernelSU/Makefile" ] || [ -f "KernelSU/kernel/Makefile" ]; then
            echo "✅ THÀNH CÔNG: Đã tải KernelSU và có file Makefile!"
          else
            echo "❌ THẤT BẠI: Không tìm thấy file Makefile trong thư mục KernelSU!"
            ls -la KernelSU/
            exit 1
          fi

      # 2. Cấu hình KernelSU vào defconfig
      - name: Enable KernelSU in defconfig
        working-directory: ./kernel
        run: |
          echo "CONFIG_KALLSYMS=y" >> arch/arm64/configs/${{ matrix.defconfig }}
          echo "CONFIG_KALLSYMS_ALL=y" >> arch/arm64/configs/${{ matrix.defconfig }}
          echo "CONFIG_KSU=y" >> arch/arm64/configs/${{ matrix.defconfig }}
          echo "CONFIG_KSU_MANUAL_HOOK=y" >> arch/arm64/configs/${{ matrix.defconfig }}
          echo "# CONFIG_KPROBES is not set" >> arch/arm64/configs/${{ matrix.defconfig }}
          echo "# CONFIG_HAVE_KPROBES is not set" >> arch/arm64/configs/${{ matrix.defconfig }}
          echo "# CONFIG_KPROBES_EVENTS is not set" >> arch/arm64/configs/${{ matrix.defconfig }}
          tail -10 arch/arm64/configs/${{ matrix.defconfig }}

      # 3. Cài đặt dependencies & Toolchain
      - name: Install build dependencies
        run: |
          sudo apt update
          sudo apt install -y bc bison flex libssl-dev make git python3 cpio gcc-aarch64-linux-gnu

      - name: Setup Neutron Clang
        run: |
          mkdir -p toolchain
          cd toolchain
          bash <(curl -s "https://raw.githubusercontent.com/Neutron-Toolchains/antman/main/antman") -S=10032024
          bash <(curl -s "https://raw.githubusercontent.com/Neutron-Toolchains/antman/main/antman") --patch=glibc
          cd ..
          echo "$(pwd)/toolchain/bin" >> $GITHUB_PATH

      - name: Set environment
        run: |
          echo "CC=clang" >> $GITHUB_ENV
          echo "LD=ld.lld" >> $GITHUB_ENV
          echo "AR=llvm-ar" >> $GITHUB_ENV
          echo "NM=llvm-nm" >> $GITHUB_ENV
          echo "OBJCOPY=llvm-objcopy" >> $GITHUB_ENV
          echo "OBJDUMP=llvm-objdump" >> $GITHUB_ENV
          echo "STRIP=llvm-strip" >> $GITHUB_ENV
          echo "CROSS_COMPILE=aarch64-linux-gnu-" >> $GITHUB_ENV
          echo "ARCH=arm64" >> $GITHUB_ENV

      # 4. Build Kernel (Chạy full, không test riêng lẻ)
      - name: Configure kernel
        working-directory: ./kernel
        run: |
          export PLATFORM_VERSION=11
          make O=out ARCH=arm64 ANDROID_MAJOR_VERSION=r ${{ matrix.defconfig }}

      - name: Build kernel
        working-directory: ./kernel
        run: |
          export PLATFORM_VERSION=11
          make -j$(nproc) O=out ARCH=arm64 ANDROID_MAJOR_VERSION=r \
            CC=${CC} LD=${LD} AR=${AR} NM=${NM} \
            OBJCOPY=${OBJCOPY} OBJDUMP=${OBJDUMP} STRIP=${STRIP} \
            CROSS_COMPILE=${CROSS_COMPILE} 2>&1 | tee build.log

      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: build-log-${{ matrix.defconfig }}
          path: kernel/build.log

      # 5. Đóng gói ZIP
      - name: Prepare AnyKernel from source
        run: |
          cp -r kernel/kernel_zip/anykernel anykernel

      - name: Copy kernel image
        run: |
          cp kernel/out/arch/arm64/boot/Image.gz-dtb anykernel/ || \
          cp kernel/out/arch/arm64/boot/Image.gz anykernel/ || \
          cp kernel/out/arch/arm64/boot/Image anykernel/

      - name: Create flashable zip
        run: |
          cd anykernel
          zip -r9 ../Haubai_${{ matrix.defconfig }}.zip *
          cd ..

      - name: Upload zip
        uses: actions/upload-artifact@v4
        with:
          name: Haubai_${{ matrix.defconfig }}
          path: Haubai_${{ matrix.defconfig }}.zip